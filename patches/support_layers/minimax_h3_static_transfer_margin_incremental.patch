+def _static_transfer_safety_margin(
+    roots: list[Any],
+    excluded_module_ids: set[int],
+    actual_static_bytes: int,
+) -> int:
+    """Derive the Strategy-A margin without a machine-tuned constant.
+
+    The validated ordinary language static inventory is compared with its
+    FP32-equivalent byte total. If the active target is not Strategy A, or
+    the actual tensors already occupy the FP32-equivalent size, no margin is
+    added. Shared direct tensors are counted once, matching the actual-byte
+    inventory.
+    """
+
+    if H3_LANGUAGE_STATIC_TARGET_DTYPE != "bfloat16":
+        return 0
+    seen: set[int] = set()
+    fp32_equivalent = 0
+    for _module, _collection, _name, tensor in _direct_tensor_slots(
+        roots, excluded_module_ids
+    ):
+        if not tensor.is_floating_point():
+            continue
+        tensor_id = id(tensor)
+        if tensor_id not in seen:
+            fp32_equivalent += int(tensor.numel()) * 4
+            seen.add(tensor_id)
+    return max(0, fp32_equivalent - int(actual_static_bytes))
