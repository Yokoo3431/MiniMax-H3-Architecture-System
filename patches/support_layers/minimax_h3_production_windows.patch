+class _MmapSafetensorsReader:
+    """CUDA-init-safe mmap safetensors reader for large checkpoints.
+
+    Same fix as qwen_encoder/loading.py: safetensors 0.7/0.8 + torch 2.12 on
+    Windows crash inside torch_cpu.dll (0xc0000005 in
+    UntypedStorage.__getitem__) when get_tensor() reads large (>~24 GB)
+    checkpoints after CUDA has been initialized.  numpy.memmap bypasses it.
+    """
+
+    _DTYPE_MAP = {
+        "F32": ("float32", "float32"),
+        "F16": ("float16", "float16"),
+        "BF16": ("uint16", "bfloat16"),
+        "I8": ("int8", "int8"),
+        "U8": ("uint8", "uint8"),
+        "I32": ("int32", "int32"),
+        "I64": ("int64", "int64"),
+        "F64": ("float64", "float64"),
+    }
+
+    def __init__(self, path) -> None:
+        import json
+        import struct
+
+        import numpy as np
+
+        self._path = str(path)
+        self._file = open(self._path, "rb")
+        header_len = struct.unpack("<Q", self._file.read(8))[0]
+        self._header = json.loads(self._file.read(header_len))
+        self._data_start = 8 + header_len
+        self._mmap = np.memmap(self._path, mode="r", offset=self._data_start)
+
+    def keys(self) -> list[str]:
+        return [k for k in self._header if isinstance(self._header[k], dict)]
+
+    def get_tensor(self, name: str):
+        import math
+
+        import numpy as np
+        import torch
+
+        info = self._header.get(name)
+        if not isinstance(info, dict):
+            raise KeyError(name)
+        start, end = info["data_offsets"]
+        shape = tuple(info["shape"])
+        dtype_name = info["dtype"]
+        try:
+            np_name, torch_name = self._DTYPE_MAP[dtype_name]
+        except KeyError:
+            raise RuntimeError(
+                f"unsupported safetensors dtype {dtype_name!r} for {name}"
+            )
+        count = int(math.prod(shape)) if shape else 1
+        if end <= start:
+            return torch.empty(shape, dtype=getattr(torch, torch_name))
+        arr = np.frombuffer(
+            self._mmap, dtype=np.dtype(np_name), count=count, offset=start
+        )
+        arr = arr.copy()
+        tensor = torch.from_numpy(arr)
+        if torch_name != str(tensor.dtype).split(".")[-1]:
+            tensor = tensor.view(getattr(torch, torch_name))
+        return tensor.reshape(shape)
+
+    def close(self) -> None:
+        try:
+            del self._mmap
+        except Exception:
+            pass
+        try:
+            self._file.close()
+        except Exception:
+            pass
+
+
+class _open_safetensors_reader:
+    """Context manager exposing keys()/get_tensor() like safe_open."""
+
+    def __init__(self, shard):
+        self._reader = _MmapSafetensorsReader(shard)
+
+    def __enter__(self):
+        return self._reader
+
+    def __exit__(self, *exc):
+        self._reader.close()
+        return False


