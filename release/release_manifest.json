{
  "version": "0.6.0",
  "system_name": "MiniMax H3 Architecture System Production Release Packager",
  "package_filename": "MiniMax-H3-Architecture-System-v0.6.0.zip",
  "include_directories": [
    "launcher",
    "runtime",
    "core",
    "configs",
    "hardware",
    "models",
    "prompts",
    "scripts",
    "skills",
    "workflows",
    "sync",
    "plugins",
    "tests",
    "docs"
  ],
  "include_files": [
    "README.md",
    ".gitignore"
  ],
  "exclude_patterns": [
    "*.mp4",
    "*.avi",
    "*.mov",
    "*.safetensors",
    "__pycache__",
    ".git",
    "userdata/outputs/*",
    "userdata/*",
    "release/*.zip"
  ]
}
