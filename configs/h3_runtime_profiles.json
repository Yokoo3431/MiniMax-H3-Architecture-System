{
  "schema_version": 1,
  "source": "models/manifest.json + configs/native_production_baseline.json",
  "selection_policy": "AUTO selects COMPATIBILITY when VRAM <= 16GB or RAM <= 32GB; unknown hardware is conservative",
  "profiles": {
    "COMPATIBILITY": {
      "hardware": {"vram_gb": "8-16", "ram_gb": "16-32"},
      "models": {
        "transformer": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
        "transformer_fallback": "MiniMax-H3-FL2VA-int8_convrot.safetensors",
        "text_encoder": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
        "video_vae": "minimax_h3_video_vae_fp16.safetensors",
        "audio_vae": "minimax_h3_audio_vae_fp32.safetensors"
      },
      "text_encoder_format": "nvfp4_awq",
      "text_encoder_loader": "native_comfy_minimax_h3",
      "dit_format": "int8_convrot_pruned",
      "workflow_backend": "runninghub_with_native_nvfp4_text_encoder",
      "runtime_flags": ["--lowvram", "--disable-async-offload", "--disable-pinned-memory"],
      "safe_load": "H3_WINDOWS_SAFE_LOAD=pread",
      "memory_policy": "conservative",
      "resolution": "1024x576",
      "notes": "Avoids the 27GB INT8 Qwen encoder; requires the pruned FL2VA DiT asset."
    },
    "BALANCED": {
      "hardware": {"vram_gb": "16-24", "ram_gb": "32-63"},
      "models": {
        "transformer": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
        "transformer_fallback": "MiniMax-H3-FL2VA-int8_convrot.safetensors",
        "text_encoder": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
        "video_vae": "minimax_h3_video_vae_fp16.safetensors",
        "audio_vae": "minimax_h3_audio_vae_fp32.safetensors"
      },
      "text_encoder_format": "nvfp4_awq",
      "text_encoder_loader": "native_comfy_minimax_h3",
      "dit_format": "int8_convrot_pruned",
      "workflow_backend": "runninghub_with_native_nvfp4_text_encoder",
      "runtime_flags": ["--disable-dynamic-vram", "--disable-async-offload", "--disable-pinned-memory"],
      "safe_load": "H3_WINDOWS_SAFE_LOAD=pread",
      "memory_policy": "balanced",
      "resolution": "1344x768",
      "notes": "Retains the verified NVFP4 encoder while allowing the balanced resolution preset."
    },
    "QUALITY": {
      "hardware": {"vram_gb": "24+", "ram_gb": "64+"},
      "models": {
        "transformer": "MiniMax-H3-FL2VA-int8_convrot.safetensors",
        "text_encoder": "qwen3-vl-32b-int8_convrot.safetensors",
        "video_vae": "minimax_h3_video_vae_fp16.safetensors",
        "audio_vae": "minimax_h3_audio_vae_fp32.safetensors"
      },
      "text_encoder_format": "int8_convrot",
      "text_encoder_loader": "runninghub_int8_convrot",
      "dit_format": "int8_convrot_full",
      "workflow_backend": "runninghub_int8_convrot",
      "runtime_flags": ["--disable-dynamic-vram", "--disable-async-offload", "--disable-pinned-memory"],
      "safe_load": "H3_WINDOWS_SAFE_LOAD=pread",
      "memory_policy": "quality",
      "resolution": "1344x768",
      "notes": "The heavier full INT8 encoder is never selected for the 12GB/32GB compatibility tier."
    }
  }
}
