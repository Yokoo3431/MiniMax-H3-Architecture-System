# Git Ignore Rules for MiniMax H3 Architecture System

# --- Python ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# --- Models (weights never committed) ---
models/*.safetensors
models/**/*.safetensors
models/**/put_*_files_here

# --- Runtime data / outputs ---
userdata/
userdata/cache/
userdata/cache/runtime/
userdata/cache/downloads/
userdata/cache/pip/
userdata/cache/huggingface/
userdata/cache/temp/
userdata/cache/extract/
!userdata/README.md
userdata/output/
userdata/projects/
userdata/personal_workspace/
userdata_backup_temp_test/
distribution_test/**/userdata/
distribution_test/**/logs/
distribution_test/**/launcher/runtime.lock
distribution_test/**/env_report.json
distribution_test/**/studio/apps/architect_video_studio/data/projects/
install_test/

# --- Internal development archive (NOT part of public release) ---
docs/internal_archive/
docs/*
!docs/Advanced_ComfyUI.md
!docs/Hardware_Requirements.md
!docs/Quick_Start.md
!docs/SHAREABLE_RC_COMPLETION_REPORT.md
!docs/Troubleshooting.md

# --- Non-public workspaces / validation tools ---
distribution_test/
install_test/
runtime/validation/
apps/architect_video_studio/data/
apps/architect_video_studio/screenshots/
apps/architect_video_studio/system/
apps/architect_video_studio/scripts/capture_r2b0_setup_screenshots.mjs
tests/assets/
runtime/logs/
runtime/native/
runtime/native.installing/
validation/runtime_native_v0331/
validation/runtime_native_v0331.installing/

# --- Legacy dev tools (historical, not part of RC public set) ---
# NOTE: explicit names only; case-insensitive globs (launcher/Start_*.bat)
# would also exclude the public start_architect_video_studio.bat.
launcher/Start_MiniMax_H3_Architect.bat
launcher/Start_H3.bat
launcher/Install_*.bat
launcher/Update_*.bat
launcher/Diagnose_*.bat

# --- User-configured native runtime root (never committed) ---
native_env.path
models_env.path

# --- Phase validation records in configs (internal) ---
configs/rc33_*
configs/rc34_*
configs/rc3_*
configs/audit_*
configs/production_environment_report.json
configs/system_version.json
configs/workflow_validation_report.json
configs/video_output_validation.json
configs/extra_model_paths.yaml
configs/model_*
configs/official_*

# --- Logs / locks ---
Logs/
logs/
*.log
runtime.lock
env_report.json

# --- Local Output Media ---
*.mp4
*.avi
*.mov
*.webm

# --- Locally built shareable artifacts (publish separately) ---
release/dist/

# --- Secrets (never commit) ---
.env
.env.*
*.key
*.pem
credentials*.json
*secret*
!**/docs/**/*secret*       # allow documentation mentions

# --- Editor / OS / agent temp ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.codex_tmp/
.agents/

# --- Misc temp ---
*.tmp
*.bak

# Environment / Temp
*.tmp
*.log
.DS_Store
Thumbs.db
